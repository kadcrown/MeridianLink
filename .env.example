# ==========================================
# MeridianLink Environment Configuration
# ==========================================

# Database
# For SQLite (local standalone dev/test): file:./dev.db
# For PostgreSQL (Docker / Production): postgresql://meridian:meridianpass@localhost:5432/meridianlink
DATABASE_URL="file:./dev.db"

# Owner Credentials
OWNER_EMAIL="owner@meridianlink.local"
OWNER_INITIAL_PASSWORD="ChangeMeInProd123!"

# Application Secret (minimum 32 characters for session encryption and visitor hashing)
APP_SECRET="meridianlink_production_secure_master_key_random_seed_9876543210"

# Application Public Origin
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Trusted Reverse Proxy Header Priority (comma separated: CF-IPCountry,X-Geo-Country,X-Vercel-IP-Country,Fly-Client-IP-Country)
TRUSTED_PROXY_HEADERS="CF-IPCountry,X-Geo-Country,X-Vercel-IP-Country,Fly-Client-IP-Country"

# Analytics & Retention
DATA_RETENTION_DAYS=90
SALT_ROTATION_INTERVAL_HOURS=24
ENABLE_BOT_FILTERING=true

# Optional Amazon Product Advertising API (PA-API v5) Credentials
# If left blank, MeridianLink operates cleanly using deterministic marketplace routing & search fallbacks
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PAAPI_PARTNER_TAG=""

# Node Environment
NODE_ENV="development"
